# --- Anthropic / LLM ---
# Ключ Anthropic (обязателен для реальных вызовов; тесты работают на моке).
ANTHROPIC_API_KEY=
# Base URL. Для доступа из РФ подменяется на свой relay-прокси вне РФ.
ANTHROPIC_BASE_URL=https://api.anthropic.com
# Исходящий прокси: http://host:port или socks5://host:port (пусто = без прокси).
OUTBOUND_PROXY_URL=
# Провайдер: anthropic | openrouter | timeweb (Timeweb AI Gateway, оплата в ₽).
LLM_PROVIDER=anthropic
# Ключ OpenRouter (нужен только при LLM_PROVIDER=openrouter).
OPENROUTER_API_KEY=

# --- Timeweb AI Gateway (OpenAI-совместимый, доступ из РФ, оплата в рублях) ---
# Ключ инференса (sk-...) из панели: AI-агенты → AI Gateway → API-ключи.
TIMEWEB_API_KEY=
# Базовый URL шлюза (по умолчанию верный).
TIMEWEB_BASE_URL=https://api.timeweb.ai/v1
# При LLM_PROVIDER=timeweb модели указываются с префиксом провайдера, напр.:
#   MODEL_INTERPRETATION=anthropic/claude-sonnet-5
#   MODEL_LIGHT=anthropic/claude-haiku-4-5

# --- Модели ---
MODEL_INTERPRETATION=claude-sonnet-5
MODEL_LIGHT=claude-haiku-4-5

# --- Аккаунты / сессии ---
# Служебный вход по ролям (#/enter) и dev-login. В проде можно оставить true
# для админ-входа; обычные пользователи входят через Яндекс (ниже).
ALLOW_DEV_LOGIN=true
# Срок жизни сессии (дней).
SESSION_TTL_DAYS=30

# --- Яндекс OAuth (реальный вход) ---
# Приложение: https://oauth.yandex.ru/client/new
#   Платформа: Web-сервисы. Redirect URI:
#     <PUBLIC_BASE_URL>/api/auth/oauth/yandex/callback
#   Права: «Доступ к адресу почты» (login:email) + «...логину, имени, фамилии».
PUBLIC_BASE_URL=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# Необязательно — если redirect отличается от PUBLIC_BASE_URL + /api/auth/oauth/yandex/callback
YANDEX_REDIRECT_URI=

# --- База данных ---
# Локально — SQLite (файл рядом). В проде задайте DATABASE_URL — она имеет
# приоритет. Подходит любой Postgres (Timeweb/Render/Neon); схему приложение
# само приведёт к psycopg. Пример:
#   DATABASE_URL=postgresql://user:pass@host:5432/kniga?sslmode=require
DB_URL=sqlite:///./iching.db
DATABASE_URL=
CORS_ORIGINS=http://localhost:5173
