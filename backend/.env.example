# --- Anthropic / LLM ---
# Ключ Anthropic (обязателен для реальных вызовов; тесты работают на моке).
ANTHROPIC_API_KEY=
# Base URL. Для доступа из РФ подменяется на свой relay-прокси вне РФ.
ANTHROPIC_BASE_URL=https://api.anthropic.com
# Исходящий прокси: http://host:port или socks5://host:port (пусто = без прокси).
OUTBOUND_PROXY_URL=
# Провайдер: anthropic (основной) | openrouter (запасной).
LLM_PROVIDER=anthropic
# Ключ OpenRouter (нужен только при LLM_PROVIDER=openrouter).
OPENROUTER_API_KEY=

# --- Модели ---
MODEL_INTERPRETATION=claude-sonnet-5
MODEL_LIGHT=claude-haiku-4-5

# --- Прочее ---
DB_URL=sqlite:///./iching.db
CORS_ORIGINS=http://localhost:5173
